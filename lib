// Переменные для динамической индикации
uint8_t current_digit = 0;
uint32_t display_buffer[4] = {0};         // Буфер для 4 разрядов
volatile uint8_t dot_flags[4] = {0};      // Флаги точек для каждого разряда

// Функция для получения кода сегмента в зависимости от типа индикатора
uint8_t GetSegmentCode(uint8_t digit, DisplayType type) {
    const uint8_t* segment_codes;
    const uint8_t* extended_codes;
    
    if (type == COMMON_CATHODE) {
        segment_codes = SEGMENT_CODES_CC;
        extended_codes = SEGMENT_CODES_EXTENDED_CC;
    } else {
        segment_codes = SEGMENT_CODES_CA;
        extended_codes = SEGMENT_CODES_EXTENDED_CA;
    }
    // Если цифра 0-9
    if (digit < 10) {
        return segment_codes[digit];
    }
    // Если буква A-Z (10-35)
    else if (digit >= 10 && digit < 36) {
        return extended_codes[digit - 10];
    }
    // Пустой символ
    else {
        return (type == COMMON_CATHODE) ? 0x00 : 0xFF;
    }
}

// Инициализация дисплея
void Display_Init(DisplayConfig* config) {
    // Настройка портов на выход
    *config->ddr_segments = config->segment_mask;
    *config->ddr_digits = config->digit_mask;
    
    // Инициализация состояний портов в зависимости от типа индикатора
    if (config->type == COMMON_CATHODE) {
        *config->port_segments = 0x00;                 // Все сегменты выключены
        *config->port_digits = 0x00;                   // Все разряды выключены
    } else {
        *config->port_segments = config->segment_mask; // Все сегменты выключены
        *config->port_digits = 0x00;                   // Все разряды выключены
    }
}

// Обновление одного разряда (вызывается в прерывании таймера)
void Display_Update(DisplayConfig* config) {
    // Выключаем текущий разряд
    if (config->type == COMMON_CATHODE) {
        *config->port_digits &= ~config->digit_mask;
    } else {
        // Для Common Anode разряды выключаются установкой 0
        *config->port_digits &= ~config->digit_mask;
    }
    
    // Получаем код сегментов для текущей цифры
    uint8_t segments = GetSegmentCode(display_buffer[current_digit], config->type);
    
    // Обрабатываем точку в зависимости от типа индикатора
    if (config->type == COMMON_CATHODE) {
        if (dot_flags[current_digit]) {
            segments |= 0x80; // Включаем точку (старший бит)
        } else {
            segments &= ~0x80; // Выключаем точку
        }
    } else {
        if (dot_flags[current_digit]) {
            segments &= ~0x80; // Включаем точку (инвертированно)
        } else {
            segments |= 0x80; // Выключаем точку
        }
    }
    
    // Устанавливаем сегменты
    *config->port_segments = segments & config->segment_mask;
    
    // Включаем текущий разряд
    uint8_t digit_mask = (1 << current_digit) & config->digit_mask;
    if (config->type == COMMON_CATHODE) {
        *config->port_digits |= digit_mask;
    } else {
        *config->port_digits |= digit_mask; // Для Common Anode тоже 1 для включения
    }
    
    // Переходим к следующему разряду
    current_digit = (current_digit + 1) % 4;
}

// Установка числового значения для отображения
void Display_SetNumber(uint32_t number) {
    uint32_t temp = number;
    
    for(uint8_t i = 0; i < 4; i++) {
        if (temp > 0 || i == 0) {
            display_buffer[3 - i] = temp % 10;
            temp /= 10;
        } else {
            display_buffer[3 - i] = 0; // Ведущие нули
        }
    }
}

// Установка произвольных символов в разряды
void Display_SetCharacters(uint8_t digit3, uint8_t digit2, uint8_t digit1, uint8_t digit0) {
    display_buffer[0] = digit0;
    display_buffer[1] = digit1;
    display_buffer[2] = digit2;
    display_buffer[3] = digit3;
}

// Установка точки для конкретного разряда
void Display_SetDot(uint8_t digit, uint8_t state) {
    if (digit < 4) {
        dot_flags[digit] = state;
    }
}

// Очистка дисплея
void Display_Clear(DisplayConfig* config) {
    for(uint8_t i = 0; i < 4; i++) {
        display_buffer[i] = 0;
        dot_flags[i] = 0;
    }
    
    if (config->type == COMMON_CATHODE) {
        *config->port_segments = 0x00;
        *config->port_digits = 0x00;
    } else {
        *config->port_segments = config->segment_mask;
        *config->port_digits = 0x00;
    }
}

// Установка типа индикатора (можно менять на лету)
void Display_SetType(DisplayConfig* config, DisplayType type) {
    config->type = type;
    Display_Clear(config);
}


