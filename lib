#include <stdint.h>

// Тип индикатора
typedef enum {
    COMMON_CATHODE,
    COMMON_ANODE
} DisplayType;

// Структура для конфигурации пинов
typedef struct {
    volatile uint8_t* port_segments;  // Порт для сегментов (a-g, dp)
    volatile uint8_t* port_digits;    // Порт для выбора разрядов
    volatile uint8_t* ddr_segments;   // DDR для сегментов
    volatile uint8_t* ddr_digits;     // DDR для разрядов
    uint8_t segment_mask;             // Маска сегментов
    uint8_t digit_mask;               // Маска разрядов
    DisplayType type;                 // Тип индикатора
} DisplayConfig;

