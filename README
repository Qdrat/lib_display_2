1. Функция установки сегментов: SegmentCallback

typedef void (*SegmentCallback)(uint8_t segment_mask);

Что делает:
Эта функция получает битовую маску всех сегментов, которые нужно включить/выключить для текущего разряда.

Битовая маска сегментов:

Бит 0 (0x01) → сегмент A
Бит 1 (0x02) → сегмент B  
Бит 2 (0x04) → сегмент C
Бит 3 (0x08) → сегмент D
Бит 4 (0x10) → сегмент E
Бит 5 (0x20) → сегмент F
Бит 6 (0x40) → сегмент G
Бит 7 (0x80) → сегмент DP (точка)

Примеры масок:
0x3F (0011 1111) → цифра "0" (включены A,B,C,D,E,F)
0x06 (0000 0110) → цифра "1" (включены B,C)
0x5B (0101 1011) → цифра "2" (включены A,B,D,E,G)
0x66 (0110 0110) → цифра "4" (включены B,C,F,G)
0x80 (1000 0000) → только точка

Как реализовать:

// Пример для прямого подключения к GPIO
void My_SetSegments(uint8_t segment_mask) {
    // Устанавливаем каждый сегмент согласно битовой маске
    HAL_GPIO_WritePin(SEG_A_GPIO_Port, SEG_A_Pin, (segment_mask & 0x01) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_B_GPIO_Port, SEG_B_Pin, (segment_mask & 0x02) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_C_GPIO_Port, SEG_C_Pin, (segment_mask & 0x04) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_D_GPIO_Port, SEG_D_Pin, (segment_mask & 0x08) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_E_GPIO_Port, SEG_E_Pin, (segment_mask & 0x10) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_F_GPIO_Port, SEG_F_Pin, (segment_mask & 0x20) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_G_GPIO_Port, SEG_G_Pin, (segment_mask & 0x40) ? ON : OFF);
    HAL_GPIO_WritePin(SEG_DP_GPIO_Port, SEG_DP_Pin, (segment_mask & 0x80) ? ON : OFF);
}


2. Функция управления разрядом: DigitCallback

typedef void (*DigitCallback)(uint8_t digit_index, uint8_t state);

Что делает:
Эта функция включает или выключает конкретный разряд индикатора.

Параметры:
digit_index - номер разряда (0 = самый правый, 1, 2, 3...)
state - состояние (1 = включить, 0 = выключить)

Как работает в динамической индикации:
Библиотека последовательно:

Вызывает set_digit(текущий, 0) - выключает текущий разряд
Вызывает set_segments(маска) - устанавливает сегменты для нового разряда
Вызывает set_digit(текущий, 1) - включает текущий разряд

Примеры вызовов:
// Для 4-разрядного дисплея:
set_digit(0, 1); // Включить правый разряд
set_digit(1, 1); // Включить второй справа разряд
set_digit(2, 0); // Выключить третий разряд
set_digit(3, 0); // Выключить левый разряд

Как реализовать:
// Пример для прямого подключения к GPIO
void My_SetDigit(uint8_t digit_index, uint8_t state) {
    switch(digit_index) {
        case 0: // Правый разряд
            HAL_GPIO_WritePin(DIGIT1_GPIO_Port, DIGIT1_Pin, state ? ON : OFF);
            break;
        case 1: // Второй разряд
            HAL_GPIO_WritePin(DIGIT2_GPIO_Port, DIGIT2_Pin, state ? ON : OFF);
            break;
        case 2: // Третий разряд
            HAL_GPIO_WritePin(DIGIT3_GPIO_Port, DIGIT3_Pin, state ? ON : OFF);
            break;
        case 3: // Левый разряд
            HAL_GPIO_WritePin(DIGIT4_GPIO_Port, DIGIT4_Pin, state ? ON : OFF);
            break;
    }
}
Полный цикл работы:
Представим, что мы хотим показать число "1234" на 4-разрядном индикаторе:

Шаг 1: Обновление разряда 0 (правый) - цифра "4"

c
set_digit(0, 0);        // Выключить разряд 0
set_segments(0x66);     // Установить сегменты для цифры "4"  
set_digit(0, 1);        // Включить разряд 0
Шаг 2: Обновление разряда 1 - цифра "3"

c
set_digit(1, 0);        // Выключить разряд 1
set_segments(0x4F);     // Установить сегменты для цифры "3"
set_digit(1, 1);        // Включить разряд 1
Шаг 3: Обновление разряда 2 - цифра "2"

c
set_digit(2, 0);        // Выключить разряд 2  
set_segments(0x5B);     // Установить сегменты для цифры "2"
set_digit(2, 1);        // Включить разряд 2
Шаг 4: Обновление разряда 3 (левый) - цифра "1"

c
set_digit(3, 0);        // Выключить разряд 3
set_segments(0x06);     // Установить сегменты для цифры "1"
set_digit(3, 1);        // Включить разряд 3
Разница между Common Cathode и Common Anode:
Common Cathode:
c
// Сегменты: 1 = включить, 0 = выключить
// Разряды: 1 = включить, 0 = выключить
void SetSegments_CC(uint8_t mask) {
    // Прямая установка битов
    SetSegmentA(mask & 0x01);
    SetSegmentB(mask & 0x02);
    // ...
}

void SetDigit_CC(uint8_t digit, uint8_t state) {
    // Прямое управление
    SetDigitPin(digit, state);
}
Common Anode:
c
// Сегменты: 0 = включить, 1 = выключить (инвертировано!)
// Разряды: 0 = включить, 1 = выключить (инвертировано!)
void SetSegments_CA(uint8_t mask) {
    // Инвертированная установка битов
    SetSegmentA(!(mask & 0x01));  // Инвертируем!
    SetSegmentB(!(mask & 0x02));  // Инвертируем!
    // ...
}

void SetDigit_CA(uint8_t digit, uint8_t state) {
    // Инвертированное управление
    SetDigitPin(digit, !state);  // Инвертируем!
}
Библиотека сама учитывает тип индикатора - вам не нужно об этом думать в callback-функциях!

Реальные примеры для разных способов подключения:
1. Прямое GPIO подключение:
c
void GPIO_SetSegments(uint8_t mask) {
    // Просто устанавливаем пины согласно маске
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0, (mask & 0x01) ? SET : RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, (mask & 0x02) ? SET : RESET);
    // ...
}

void GPIO_SetDigit(uint8_t digit, uint8_t state) {
    // Включаем/выключаем конкретный разряд
    uint16_t pins[] = {GPIO_PIN_8, GPIO_PIN_9, GPIO_PIN_10, GPIO_PIN_11};
    HAL_GPIO_WritePin(GPIOB, pins[digit], state ? SET : RESET);
}
2. Подключение через сдвиговый регистр (74HC595):
c
void ShiftRegister_SetSegments(uint8_t mask) {
    // Отправляем маску в сдвиговый регистр
    HAL_GPIO_WritePin(LATCH_GPIO_Port, LATCH_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi1, &mask, 1, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(LATCH_GPIO_Port, LATCH_Pin, GPIO_PIN_SET);
}

void ShiftRegister_SetDigit(uint8_t digit, uint8_t state) {
    // Управляем разрядами через второй регистр
    uint8_t digit_mask = (1 << digit);
    HAL_GPIO_WritePin(LATCH_GPIO_Port, LATCH_Pin, GPIO_PIN_RESET);
    HAL_SPI_Transmit(&hspi1, &digit_mask, 1, HAL_MAX_DELAY);
    HAL_GPIO_WritePin(LATCH_GPIO_Port, LATCH_Pin, GPIO_PIN_SET);
}
3. Подключение через I2C расширитель (PCF8574):
c
void I2C_SetSegments(uint8_t mask) {
    // Отправляем маску по I2C
    uint8_t data[2] = {0x01, mask}; // Команда + данные
    HAL_I2C_Master_Transmit(&hi2c1, 0x20<<1, data, 2, HAL_MAX_DELAY);
}

void I2C_SetDigit(uint8_t digit, uint8_t state) {
    // Управляем разрядами через второй I2C расширитель
    uint8_t digit_mask = state ? (1 << digit) : 0;
    uint8_t data[2] = {0x01, digit_mask};
    HAL_I2C_Master_Transmit(&hi2c1, 0x21<<1, data, 2, HAL_MAX_DELAY);
}
Ключевые моменты для понимания:
set_segments - говорит "какие сегменты светятся" (вся цифра)
set_digit - говорит "какой разряд сейчас активен"
Библиотека сама переключает разряды - вам не нужно управлять динамической индикацией
Вам нужно только реализовать эти 2 функции под ваше железо
Функции должны быть быстрыми - они вызываются в прерывании таймера
